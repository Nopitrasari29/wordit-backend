# DATABASE
POSTGRES_PORT=5434
POSTGRES_NAME=wordit_db
POSTGRES_USER=wordit_user
POSTGRES_PASSWORD=wordit_pass
DATABASE_URL="postgresql://wordit_user:wordit_pass@localhost:5434/wordit_db"

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# SERVER
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI PROVIDERS
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# TELEGRAM BOT ALERT
TELE_BOT_TOKEN=your_telegram_bot_token
TELE_ADMIN_ID=your_telegram_admin_chat_id

# LTI (MOODLE)
LTI_DB_URL="mongodb://localhost:27017/wordit-lti"
LTI_PLATFORM_URL="http://your-moodle-url/moodle"
LTI_CLIENT_ID="your_moodle_client_id"
LTI_DEPLOYMENT_ID="1"
LTI_AUTH_ENDPOINT="http://your-moodle-url/moodle/mod/lti/auth.php"
LTI_TOKEN_ENDPOINT="http://your-moodle-url/moodle/mod/lti/token.php"
LTI_KEYSET_ENDPOINT="http://your-moodle-url/moodle/mod/lti/certs.php"
LTI_ENABLED=false
MOODLE_JWKS_URI=""

# SMTP EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="WordIT <your_email@gmail.com>"
